# The service does not load this file itself. Inject these values through your process manager,
# container runtime, Kubernetes Secret/ConfigMap, or a local env loader.
AI_RUNTIME_ENVIRONMENT=development

# Safe default: no outbound model request is made.
AI_RUNTIME_DRIVER=noop

# memory is development-only. The postgres adapter is a required next implementation step;
# selecting postgres without injecting that adapter intentionally fails startup.
AI_RUNTIME_STORE_DRIVER=memory

# Required only when AI_RUNTIME_DRIVER=openai_compatible.
# Never commit a real key and never place credentials in the base URL.
AI_RUNTIME_OPENAI_BASE_URL=https://provider.example.com/v1
AI_RUNTIME_OPENAI_API_KEY=replace-with-secret-manager-reference
AI_RUNTIME_OPENAI_MODEL=replace-with-model-deployment-name

# Knowledge providers are independent from AI_RUNTIME_DRIVER and disabled by default.
# The embedding endpoint is {BASE_URL}/embeddings and the vector dimension is fixed at 1536.
AI_RUNTIME_EMBEDDING_DRIVER=disabled
AI_RUNTIME_EMBEDDING_BASE_URL=https://embedding-provider.example.com/v1
AI_RUNTIME_EMBEDDING_API_KEY=replace-with-secret-manager-reference
AI_RUNTIME_EMBEDDING_MODEL=replace-with-embedding-deployment-name
AI_RUNTIME_EMBEDDING_DIMENSIONS=1536
AI_RUNTIME_EMBEDDING_TIMEOUT_SECONDS=30

# The rerank endpoint is {BASE_URL}/rerank and uses a Cohere-compatible request/response.
AI_RUNTIME_RERANK_DRIVER=disabled
AI_RUNTIME_RERANK_BASE_URL=https://rerank-provider.example.com/v2
AI_RUNTIME_RERANK_API_KEY=replace-with-secret-manager-reference
AI_RUNTIME_RERANK_MODEL=replace-with-rerank-deployment-name
AI_RUNTIME_RERANK_TIMEOUT_SECONDS=30
