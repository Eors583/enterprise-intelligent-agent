# The service does not load this file itself. Inject these values through your process manager,
# container runtime, Kubernetes Secret/ConfigMap, or a local env loader.
AI_RUNTIME_ENVIRONMENT=development

# Safe default: no outbound model request is made.
AI_RUNTIME_DRIVER=noop

# Production must require a trusted route snapshot and define a server-side
# allowlist. Each entry contains only immutable identity metadata and a vault
# reference; provider URLs and plaintext credentials are intentionally invalid.
AI_RUNTIME_REQUIRE_TRUSTED_MODEL_ROUTE=false
AI_RUNTIME_MODEL_ROUTE_CATALOG=
# Example shape after selecting a non-noop driver:
# [{"route_key":"GENERAL_PRIMARY","catalog_version_id":"00000000-0000-7000-8000-000000000001","provider":"OPENAI_COMPATIBLE","model":"enterprise-chat","credential_reference":"vault://ai/providers/general"}]

# memory is development-only. Production must use the durable PostgreSQL adapter.
AI_RUNTIME_STORE_DRIVER=memory
AI_RUNTIME_POSTGRES_DSN=postgresql://runtime-role:replace-with-secret@postgres.example/runtime?sslmode=verify-full
AI_RUNTIME_POSTGRES_POOL_MIN_SIZE=1
AI_RUNTIME_POSTGRES_POOL_MAX_SIZE=10
AI_RUNTIME_POSTGRES_COMMAND_TIMEOUT_SECONDS=10

# Required in production and shared only with the trusted API caller.
AI_RUNTIME_SERVICE_TOKEN=replace-with-at-least-32-random-characters

# Must match API AI_EVALUATION_RUNNER_HMAC_SECRET. Without it the Runtime
# reports evaluation attestation as disabled and refuses evaluation execution.
AI_RUNTIME_EVALUATION_ATTESTATION_SECRET=

# OpenTelemetry OTLP/HTTP. In the repository's shared dotenv, use these scoped aliases so
# the API and Runtime keep distinct service names. Standard OTEL_* process variables remain
# supported. Production defaults OTEL_REQUIRED to true when neither alias is provided.
AI_RUNTIME_OTEL_REQUIRED=false
AI_RUNTIME_OTEL_SDK_DISABLED=false
AI_RUNTIME_OTEL_SERVICE_NAME=enterprise-ai-runtime
AI_RUNTIME_OTEL_EXPORTER_OTLP_ENDPOINT=
AI_RUNTIME_OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
AI_RUNTIME_OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
AI_RUNTIME_OTEL_EXPORTER_OTLP_HEADERS=
AI_RUNTIME_OTEL_EXPORTER_OTLP_TIMEOUT=5
AI_RUNTIME_OTEL_EXPORT_STALE_AFTER_SECONDS=120
AI_RUNTIME_OTEL_METRIC_EXPORT_INTERVAL=30000
AI_RUNTIME_OTEL_TRACES_SAMPLER_ARG=1

# Required only when AI_RUNTIME_DRIVER=openai_compatible.
# Never commit a real key and never place credentials in the base URL.
AI_RUNTIME_OPENAI_BASE_URL=https://provider.example.com/v1
AI_RUNTIME_OPENAI_API_KEY=replace-with-secret-manager-reference
AI_RUNTIME_OPENAI_MODEL=replace-with-model-deployment-name

# Knowledge providers are independent from AI_RUNTIME_DRIVER and disabled by default.
# The embedding endpoint is {BASE_URL}/embeddings and the vector dimension is fixed at 1536.
AI_RUNTIME_EMBEDDING_DRIVER=disabled
AI_RUNTIME_EMBEDDING_BASE_URL=https://embedding-provider.example.com/v1
AI_RUNTIME_EMBEDDING_API_KEY=replace-with-secret-manager-reference
AI_RUNTIME_EMBEDDING_MODEL=replace-with-embedding-deployment-name
AI_RUNTIME_EMBEDDING_DIMENSIONS=1536
AI_RUNTIME_EMBEDDING_TIMEOUT_SECONDS=30

# The rerank endpoint is {BASE_URL}/rerank and uses a Cohere-compatible request/response.
AI_RUNTIME_RERANK_DRIVER=disabled
AI_RUNTIME_RERANK_BASE_URL=https://rerank-provider.example.com/v2
AI_RUNTIME_RERANK_API_KEY=replace-with-secret-manager-reference
AI_RUNTIME_RERANK_MODEL=replace-with-rerank-deployment-name
AI_RUNTIME_RERANK_TIMEOUT_SECONDS=30
