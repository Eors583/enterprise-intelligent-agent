{
  "name": "@enterprise/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Enterprise AI collaboration platform API",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch --path tsconfig.dev.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run test/app.e2e-spec.ts",
    "test:dev-build-isolation": "node scripts/verify-dev-build-isolation.mjs",
    "test:db": "node scripts/test-database.mjs",
    "lint": "tsc --noEmit",
    "prisma:generate": "node scripts/prisma.mjs generate",
    "prisma:validate": "node scripts/prisma.mjs validate",
    "prisma:migrate": "node scripts/prisma.mjs migrate deploy",
    "prisma:seed": "node scripts/prisma.mjs db seed"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1095.0",
    "@enterprise/contracts": "workspace:*",
    "@nestjs/common": "^11.1.0",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@prisma/client": "6.19.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "mammoth": "^1.12.0",
    "pdf-parse": "^2.4.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.7",
    "@nestjs/schematics": "^11.0.5",
    "@nestjs/testing": "^11.1.0",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.13",
    "@types/supertest": "^6.0.3",
    "jszip": "^3.10.1",
    "prisma": "6.19.0",
    "supertest": "^7.1.1",
    "ts-node": "^10.9.2",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "prisma": {
    "seed": "node --loader ts-node/esm prisma/seed.ts"
  }
}
