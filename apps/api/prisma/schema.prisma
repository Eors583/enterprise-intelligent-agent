  agent         AgentInstance @relation(fields: [tenantId, agentId], references: [tenantId, id], onDelete: Restrict)
  agentVersion  AgentVersion  @relation(fields: [tenantId, agentVersionId], references: [tenantId, id], onDelete: Restrict)
  parentRun     AgentRun?     @relation("AgentRunRelayChain", fields: [tenantId, parentRunId], references: [tenantId, id], onDelete: Restrict)
  childRuns     AgentRun[]    @relation("AgentRunRelayChain")
  retryOf       AgentRun?     @relation("AgentRunRetries", fields: [tenantId, retryOfRunId], references: [tenantId, id], onDelete: Restrict)
  retries       AgentRun[]    @relation("AgentRunRetries")

  @@unique([tenantId, id])
  @@unique([tenantId, outputMessageId])
  @@unique([tenantId, parentRunId])
  @@unique([tenantId, idempotencyKey])
  @@unique([tenantId, provider, externalRunId])
  @@index([tenantId, inputMessageId, agentId])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, finishedAt])
  @@index([tenantId, runtimeProvider, runtimeModel, finishedAt], map: "agent_runs_tenant_runtime_model_finished_at_idx")
  @@index([tenantId, conversationId, turnIndex])
  @@index([tenantId, conversationId, status, createdAt, id])
  @@map("agent_runs")
}

model OutboxEvent {
  id               String            @id @default(uuid()) @db.Uuid
  tenantId         String            @map("tenant_id") @db.Uuid
  aggregateType    String            @map("aggregate_type") @db.VarChar(100)
  aggregateId      String            @map("aggregate_id") @db.Uuid
  eventType        String            @map("event_type") @db.VarChar(160)
  payload          Json
  status           OutboxEventStatus @default(PENDING)
  attempts         Int               @default(0)
  availableAt      DateTime          @default(now()) @map("available_at") @db.Timestamptz(6)
  lockedBy         String?           @map("locked_by") @db.VarChar(120)
  lockedUntil      DateTime?         @map("locked_until") @db.Timestamptz(6)
  lastError        String?           @map("last_error") @db.Text
  providerName     String?           @map("provider_name") @db.VarChar(80)
  providerReceipt  Json?             @map("provider_receipt")
  firstAttemptedAt DateTime?         @map("first_attempted_at") @db.Timestamptz(6)
  publishedAt      DateTime?         @map("published_at") @db.Timestamptz(6)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, status, availableAt])
  @@index([tenantId, aggregateType, aggregateId])
  @@index([eventType, status, availableAt, lockedUntil, createdAt, id], map: "outbox_events_delivery_claim_idx")
  @@map("outbox_events")
}

model AuditEvent {
  id           String         @id @default(uuid()) @db.Uuid
  tenantId     String         @map("tenant_id") @db.Uuid
  actorType    AuditActorType @map("actor_type")
  actorId      String         @map("actor_id") @db.Uuid
  action       String         @db.VarChar(160)
  resourceType String         @map("resource_type") @db.VarChar(100)
  resourceId   String         @map("resource_id") @db.Uuid
  metadata     Json           @default("{}")
  occurredAt   DateTime       @default(now()) @map("occurred_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, occurredAt(sort: Desc)])
  @@index([tenantId, resourceType, resourceId, occurredAt(sort: Desc)])
  @@map("audit_events")
}
