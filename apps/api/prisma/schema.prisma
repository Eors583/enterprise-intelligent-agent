generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
}

enum TenantRole {
  OWNER
  ADMIN
  KNOWLEDGE_ADMIN
  MEMBER
}

enum OrgUnitStatus {
  ACTIVE
  ARCHIVED
}

enum KnowledgeBaseStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum KnowledgeDocumentStatus {
  DRAFT
  PROCESSING
  READY
  FAILED
  ARCHIVED
}

enum KnowledgeDocumentVersionStatus {
  DRAFT
  PROCESSING
  READY
  FAILED
  ARCHIVED
}

enum KnowledgeIngestionStage {
  UPLOADED
  SECURITY_CHECK
  PARSING
  CHUNKING
  INDEXING
  READY
}

enum KnowledgeIngestionStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

enum KnowledgeSourceType {
  TEXT
  MARKDOWN
  FILE
}

enum EmploymentStatus {
  PENDING
  ACTIVE
  SUSPENDED
  TERMINATED
}

enum ManagerRelationType {
  DIRECT
  DOTTED_LINE
}

enum AgentVersionStatus {
  DRAFT
  TESTING
  PUBLISHED
  RETIRED
}

enum AgentInstanceStatus {
  ONLINE
  OFFLINE
  DISABLED
}

enum AgentRunStatus {
  QUEUED
  DISPATCHING
  RUNNING
  SUCCEEDED
  FAILED
  UNKNOWN
  CANCELLED
}

enum AgentRunTrigger {
  USER_MESSAGE
  RELAY_TURN
}

enum ConversationType {
  DIRECT
}

enum ConversationParticipantType {
  USER
  AGENT
}

enum MessageContentType {
  TEXT
}

enum AnswerFeedbackRating {
  HELPFUL
  NOT_HELPFUL
}

enum AnswerFeedbackReason {
  INCORRECT
  IRRELEVANT_CITATION
  OUTDATED
  MISSING_KNOWLEDGE
  OTHER
}

enum OutboxEventStatus {
  PENDING
  PUBLISHED
  FAILED
  UNKNOWN
}

enum AuditActorType {
  USER
  AGENT
  SERVICE
}

enum DirectoryProvider {
  FEISHU
}

enum DirectorySyncStatus {
  IDLE
  RUNNING
  SUCCEEDED
  FAILED
}

model Tenant {
  id                         String       @id @default(uuid()) @db.Uuid
  slug                       String       @unique @db.VarChar(80)
  name                       String       @db.VarChar(200)
  status                     TenantStatus @default(ACTIVE)
  agentRunConcurrencyLimit   Int          @default(4) @map("agent_run_concurrency_limit")
  agentRunRateLimitPerMinute Int          @default(60) @map("agent_run_rate_limit_per_minute")
  agentRunMonthlyTokenLimit  BigInt       @default(100000000) @map("agent_run_monthly_token_limit")
  createdAt                  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  users                       User[]
  organizations               Organization[]
  orgUnits                    OrgUnit[]
  employments                 Employment[]
  positions                   Position[]
  managerLinks                ManagerRelation[]
  agentTemplates              AgentTemplate[]
  agentVersions               AgentVersion[]
  agentInstances              AgentInstance[]
  agentRuns                   AgentRun[]
  conversations               Conversation[]
  conversationParticipants    ConversationParticipant[]
  messages                    Message[]
  answerFeedbacks             AnswerFeedback[]
  outboxEvents                OutboxEvent[]
  auditEvents                 AuditEvent[]
  passwordCredentials         PasswordCredential[]
  authSessions                AuthSession[]
  authActionTokens            AuthActionToken[]
  knowledgeBases              KnowledgeBase[]
  knowledgeDocuments          KnowledgeDocument[]
  knowledgeDocumentVersions   KnowledgeDocumentVersion[]
  knowledgeChunks             KnowledgeChunk[]
  knowledgeChunkEmbeddings    KnowledgeChunkEmbedding[]
  knowledgeIngestionJobs      KnowledgeIngestionJob[]
  knowledgeBaseOrgUnits       KnowledgeBaseOrgUnit[]
  directoryIntegrations       DirectoryIntegration[]
  directoryUserBindings       DirectoryUserBinding[]
  directoryOrgUnitBindings    DirectoryOrgUnitBinding[]
  directoryEmploymentBindings DirectoryEmploymentBinding[]

  @@map("tenants")
}

/// Cross-tenant authentication throttle state. Keys are HMAC digests, never
/// raw tenant slugs, email addresses, or network addresses.
model AuthLoginRateLimit {
  keyHash         String    @id @map("key_hash") @db.VarChar(64)
  scope           String    @db.VarChar(32)
  failureCount    Int       @default(0) @map("failure_count")
  windowStartedAt DateTime  @default(now()) @map("window_started_at") @db.Timestamptz(6)
  blockedUntil    DateTime? @map("blocked_until") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@index([updatedAt], map: "auth_login_rate_limits_updated_at_idx")
  @@map("auth_login_rate_limits")
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  tenantId        String     @map("tenant_id") @db.Uuid
  email           String     @db.VarChar(320)
  emailNormalized String     @map("email_normalized") @db.VarChar(320)
  phone           String?    @db.VarChar(40)
  displayName     String     @map("display_name") @db.VarChar(120)
  avatarUrl       String?    @map("avatar_url") @db.Text
  status          UserStatus @default(ACTIVE)
  role            TenantRole @default(MEMBER)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant                           Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  employments                      Employment[]
  ownedAgents                      AgentInstance[]            @relation("AgentOwner")
  createdAgents                    AgentInstance[]            @relation("AgentCreator")
  createdConversations             Conversation[]             @relation("ConversationCreator")
  conversationParticipants         ConversationParticipant[]
  sentMessages                     Message[]                  @relation("UserSentMessages")
  passwordCredential               PasswordCredential?
  authSessions                     AuthSession[]
  authActionTokens                 AuthActionToken[]          @relation("AuthActionTokenUser")
  createdAuthActionTokens          AuthActionToken[]          @relation("AuthActionTokenCreator")
  createdKnowledgeBases            KnowledgeBase[]            @relation("KnowledgeBaseCreator")
  createdKnowledgeDocuments        KnowledgeDocument[]        @relation("KnowledgeDocumentCreator")
  createdKnowledgeDocumentVersions KnowledgeDocumentVersion[] @relation("KnowledgeDocumentVersionCreator")
  requestedAgentRuns               AgentRun[]                 @relation("AgentRunRequester")
  directoryBindings                DirectoryUserBinding[]
  answerFeedbacks                  AnswerFeedback[]

  // Composite candidate key for tenant-scoped foreign keys. The globally
  // unique id remains the primary key, while relations must also prove that
  // their parent belongs to the same tenant.
  @@unique([tenantId, id])
  @@unique([tenantId, email])
  @@unique([tenantId, emailNormalized])
  @@index([tenantId, status])
  @@map("users")
}

model Organization {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  externalKey String?  @map("external_key") @db.VarChar(200)
  name        String   @db.VarChar(200)
  legalName   String?  @map("legal_name") @db.VarChar(300)
  countryCode String?  @map("country_code") @db.Char(2)
  timezone    String   @default("Asia/Shanghai") @db.VarChar(80)
  version     Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  orgUnits              OrgUnit[]
  employments           Employment[]
  positions             Position[]
  directoryIntegrations DirectoryIntegration[]

  @@unique([tenantId, id])
  @@unique([tenantId, externalKey])
  @@index([tenantId, name])
  @@map("organizations")
}

model OrgUnit {
  id             String        @id @default(uuid()) @db.Uuid
  tenantId       String        @map("tenant_id") @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  parentId       String?       @map("parent_id") @db.Uuid
  externalKey    String?       @map("external_key") @db.VarChar(200)
  name           String        @db.VarChar(200)
  sortOrder      Int           @default(0) @map("sort_order")
  status         OrgUnitStatus @default(ACTIVE)
  version        Int           @default(1)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant              Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  organization        Organization              @relation(fields: [tenantId, organizationId], references: [tenantId, id], onDelete: Restrict)
  parent              OrgUnit?                  @relation("OrgUnitTree", fields: [tenantId, organizationId, parentId], references: [tenantId, organizationId, id], onDelete: Restrict)
  children            OrgUnit[]                 @relation("OrgUnitTree")
  employments         Employment[]
  positions           Position[]
  knowledgeBaseScopes KnowledgeBaseOrgUnit[]
  directoryBindings   DirectoryOrgUnitBinding[]

  @@unique([tenantId, id])
  @@unique([tenantId, organizationId, id])
  @@unique([tenantId, organizationId, externalKey])
  @@index([tenantId, parentId, sortOrder])
  @@map("org_units")
}

model PasswordCredential {
  userId             String   @id @map("user_id") @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  passwordHash       String   @map("password_hash") @db.Text
  mustChangePassword Boolean  @default(false) @map("must_change_password")
  passwordChangedAt  DateTime @default(now()) @map("password_changed_at") @db.Timestamptz(6)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@map("password_credentials")
}

model AuthSession {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  accessTokenHash  String    @unique @map("access_token_hash") @db.Char(64)
  refreshTokenHash String    @unique @map("refresh_token_hash") @db.Char(64)
  label            String?   @db.VarChar(120)
  accessExpiresAt  DateTime  @map("access_expires_at") @db.Timestamptz(6)
  refreshExpiresAt DateTime  @map("refresh_expires_at") @db.Timestamptz(6)
  lastUsedAt       DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, userId, revokedAt])
  @@index([accessExpiresAt])
  @@index([refreshExpiresAt])
  @@map("auth_sessions")
}

/// One-time password-reset and member-invitation capability. The raw token is
/// never persisted; tokenHash is an HMAC using the authentication pepper.
model AuthActionToken {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  purpose          String    @db.VarChar(32)
  tokenHash        String    @unique @map("token_hash") @db.Char(64)
  deliveryStatus   String    @default("PENDING") @map("delivery_status") @db.VarChar(24)
  deliveryAttempts Int       @default(0) @map("delivery_attempts")
  lastDeliveryAt   DateTime? @map("last_delivery_at") @db.Timestamptz(6)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt       DateTime? @map("consumed_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdById      String?   @map("created_by_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user      User   @relation("AuthActionTokenUser", fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)
  createdBy User?  @relation("AuthActionTokenCreator", fields: [tenantId, createdById], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, userId, purpose, createdAt(sort: Desc)])
  @@index([expiresAt])
  @@map("auth_action_tokens")
}

model KnowledgeBase {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String              @map("tenant_id") @db.Uuid
  key         String              @db.VarChar(100)
  name        String              @db.VarChar(200)
  description String?             @db.Text
  status      KnowledgeBaseStatus @default(DRAFT)
  createdById String              @map("created_by_id") @db.Uuid
  version     Int                 @default(1)
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant           Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdBy        User                       @relation("KnowledgeBaseCreator", fields: [tenantId, createdById], references: [tenantId, id], onDelete: Restrict)
  orgUnits         KnowledgeBaseOrgUnit[]
  documents        KnowledgeDocument[]
  documentVersions KnowledgeDocumentVersion[]
  chunks           KnowledgeChunk[]

  @@unique([tenantId, id])
  @@unique([tenantId, key])
  @@index([tenantId, status, name])
  @@map("knowledge_bases")
}

model KnowledgeBaseOrgUnit {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  knowledgeBaseId String   @map("knowledge_base_id") @db.Uuid
  orgUnitId       String   @map("org_unit_id") @db.Uuid
  includeChildren Boolean  @default(true) @map("include_children")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  knowledgeBase KnowledgeBase @relation(fields: [tenantId, knowledgeBaseId], references: [tenantId, id], onDelete: Cascade)
  orgUnit       OrgUnit       @relation(fields: [tenantId, orgUnitId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, knowledgeBaseId, orgUnitId], map: "knowledge_base_org_units_tenant_id_knowledge_base_id_org_unit_i")
  @@index([tenantId, orgUnitId])
  @@map("knowledge_base_org_units")
}

model KnowledgeDocument {
  id               String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String                  @map("tenant_id") @db.Uuid
  knowledgeBaseId  String                  @map("knowledge_base_id") @db.Uuid
  title            String                  @db.VarChar(300)
  sourceType       KnowledgeSourceType     @map("source_type")
  mimeType         String?                 @map("mime_type") @db.VarChar(160)
  fileName         String?                 @map("file_name") @db.VarChar(300)
  contentText      String?                 @map("content_text") @db.Text
  objectKey        String?                 @map("object_key") @db.Text
  checksum         String?                 @db.Char(64)
  status           KnowledgeDocumentStatus @default(DRAFT)
  documentVersion  Int                     @default(1) @map("document_version")
  currentVersionId String?                 @map("current_version_id") @db.Uuid
  createdById      String                  @map("created_by_id") @db.Uuid
  createdAt        DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant         Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  knowledgeBase  KnowledgeBase              @relation(fields: [tenantId, knowledgeBaseId], references: [tenantId, id], onDelete: Restrict)
  createdBy      User                       @relation("KnowledgeDocumentCreator", fields: [tenantId, createdById], references: [tenantId, id], onDelete: Restrict)
  currentVersion KnowledgeDocumentVersion?  @relation("KnowledgeDocumentCurrentVersion", fields: [tenantId, knowledgeBaseId, id, currentVersionId], references: [tenantId, knowledgeBaseId, documentId, id], onDelete: Restrict, onUpdate: NoAction, map: "knowledge_documents_current_version_fkey")
  versions       KnowledgeDocumentVersion[] @relation("KnowledgeDocumentVersionHistory")
  chunks         KnowledgeChunk[]

  @@unique([tenantId, id])
  @@unique([tenantId, knowledgeBaseId, id], map: "knowledge_documents_scope_identity_key")
  @@unique([tenantId, knowledgeBaseId, id, currentVersionId], map: "knowledge_documents_current_version_identity_key")
  @@index([tenantId, knowledgeBaseId, status, updatedAt(sort: Desc)], map: "knowledge_documents_tenant_id_knowledge_base_id_status_updated_")
  @@map("knowledge_documents")
}

model KnowledgeDocumentVersion {
  id              String                         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String                         @map("tenant_id") @db.Uuid
  knowledgeBaseId String                         @map("knowledge_base_id") @db.Uuid
  documentId      String                         @map("document_id") @db.Uuid
  versionNumber   Int                            @map("version_number")
  sourceType      KnowledgeSourceType            @map("source_type")
  mimeType        String?                        @map("mime_type") @db.VarChar(160)
  fileName        String?                        @map("file_name") @db.VarChar(300)
  objectKey       String?                        @map("object_key") @db.Text
  objectSize      Int?                           @map("object_size")
  objectSha256    String?                        @map("object_sha256") @db.Char(64)
  checksum        String?                        @db.Char(64)
  contentText     String?                        @map("content_text") @db.Text
  status          KnowledgeDocumentVersionStatus @default(DRAFT)
  changeSummary   String?                        @map("change_summary") @db.VarChar(500)
  createdById     String                         @map("created_by_id") @db.Uuid
  createdAt       DateTime                       @default(now()) @map("created_at") @db.Timestamptz(6)
  publishedAt     DateTime?                      @map("published_at") @db.Timestamptz(6)

  tenant             Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "knowledge_document_versions_tenant_id_fkey")
  knowledgeBase      KnowledgeBase           @relation(fields: [tenantId, knowledgeBaseId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction, map: "knowledge_document_versions_knowledge_base_fkey")
  document           KnowledgeDocument       @relation("KnowledgeDocumentVersionHistory", fields: [tenantId, knowledgeBaseId, documentId], references: [tenantId, knowledgeBaseId, id], onDelete: Restrict, onUpdate: NoAction, map: "knowledge_document_versions_document_fkey")
  currentForDocument KnowledgeDocument?      @relation("KnowledgeDocumentCurrentVersion")
  createdBy          User                    @relation("KnowledgeDocumentVersionCreator", fields: [tenantId, createdById], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction, map: "knowledge_document_versions_created_by_fkey")
  chunks             KnowledgeChunk[]
  ingestionJobs      KnowledgeIngestionJob[]

  @@unique([tenantId, id])
  @@unique([tenantId, documentId, id], map: "knowledge_document_versions_document_identity_key")
  @@unique([tenantId, knowledgeBaseId, documentId, id], map: "knowledge_document_versions_scope_identity_key")
  @@unique([tenantId, documentId, versionNumber], map: "knowledge_document_versions_number_key")
  @@index([tenantId, knowledgeBaseId, status, createdAt(sort: Desc)], map: "knowledge_document_versions_lookup_idx")
  @@map("knowledge_document_versions")
}

model KnowledgeChunk {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  knowledgeBaseId   String   @map("knowledge_base_id") @db.Uuid
  documentId        String   @map("document_id") @db.Uuid
  documentVersionId String   @map("document_version_id") @db.Uuid
  chunkIndex        Int      @map("chunk_index")
  headingPath       String[] @default([]) @map("heading_path")
  content           String   @db.Text
  tokenCount        Int      @map("token_count")
  contentHash       String   @map("content_hash") @db.Char(64)
  metadata          Json     @default("{}")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant          Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "knowledge_chunks_tenant_id_fkey")
  knowledgeBase   KnowledgeBase             @relation(fields: [tenantId, knowledgeBaseId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction, map: "knowledge_chunks_knowledge_base_fkey")
  document        KnowledgeDocument         @relation(fields: [tenantId, knowledgeBaseId, documentId], references: [tenantId, knowledgeBaseId, id], onDelete: Restrict, onUpdate: NoAction, map: "knowledge_chunks_document_fkey")
  documentVersion KnowledgeDocumentVersion  @relation(fields: [tenantId, knowledgeBaseId, documentId, documentVersionId], references: [tenantId, knowledgeBaseId, documentId, id], onDelete: Cascade, onUpdate: NoAction, map: "knowledge_chunks_document_version_fkey")
  embeddings      KnowledgeChunkEmbedding[]

  @@unique([tenantId, id])
  @@unique([tenantId, documentVersionId, chunkIndex], map: "knowledge_chunks_version_index_key")
  @@index([tenantId, documentVersionId, contentHash], map: "knowledge_chunks_version_hash_idx")
  @@index([tenantId, knowledgeBaseId, documentId], map: "knowledge_chunks_scope_idx")
  @@index([content(ops: raw("gin_trgm_ops"))], type: Gin, map: "knowledge_chunks_content_trgm_idx")
  @@map("knowledge_chunks")
}

model KnowledgeChunkEmbedding {
  id                 String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String                      @map("tenant_id") @db.Uuid
  chunkId            String                      @map("chunk_id") @db.Uuid
  embeddingModel     String                      @map("embedding_model") @db.VarChar(200)
  embeddingDimension Int                         @map("embedding_dimension")
  contentHash        String                      @map("content_hash") @db.Char(64)
  embedding          Unsupported("vector(1536)")
  createdAt          DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "knowledge_chunk_embeddings_tenant_id_fkey")
  chunk  KnowledgeChunk @relation(fields: [tenantId, chunkId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction, map: "knowledge_chunk_embeddings_chunk_fkey")

  @@unique([tenantId, chunkId, embeddingModel], map: "knowledge_chunk_embeddings_tenant_chunk_model_key")
  @@index([tenantId, embeddingModel], map: "knowledge_chunk_embeddings_tenant_model_idx")
  @@map("knowledge_chunk_embeddings")
}

model KnowledgeIngestionJob {
  id                String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String                   @map("tenant_id") @db.Uuid
  documentVersionId String                   @map("document_version_id") @db.Uuid
  stage             KnowledgeIngestionStage  @default(UPLOADED)
  status            KnowledgeIngestionStatus @default(PENDING)
  progress          Int                      @default(0)
  attempts          Int                      @default(0)
  availableAt       DateTime                 @default(now()) @map("available_at") @db.Timestamptz(6)
  claimedBy         String?                  @map("claimed_by") @db.VarChar(200)
  leaseExpiresAt    DateTime?                @map("lease_expires_at") @db.Timestamptz(6)
  errorCode         String?                  @map("error_code") @db.VarChar(120)
  errorMessage      String?                  @map("error_message") @db.VarChar(500)
  startedAt         DateTime?                @map("started_at") @db.Timestamptz(6)
  finishedAt        DateTime?                @map("finished_at") @db.Timestamptz(6)
  createdAt         DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant          Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "knowledge_ingestion_jobs_tenant_id_fkey")
  documentVersion KnowledgeDocumentVersion @relation(fields: [tenantId, documentVersionId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction, map: "knowledge_ingestion_jobs_document_version_fkey")

  @@unique([tenantId, id])
