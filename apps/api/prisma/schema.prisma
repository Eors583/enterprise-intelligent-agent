model Tenant {
  id                         String       @id @default(uuid()) @db.Uuid
  slug                       String       @unique @db.VarChar(80)
  name                       String       @db.VarChar(200)
  status                     TenantStatus @default(ACTIVE)
  agentRunConcurrencyLimit   Int          @default(4) @map("agent_run_concurrency_limit")
  agentRunRateLimitPerMinute Int          @default(60) @map("agent_run_rate_limit_per_minute")
  agentRunMonthlyTokenLimit  BigInt       @default(100000000) @map("agent_run_monthly_token_limit")
  createdAt                  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  users                       User[]
  organizations               Organization[]
  orgUnits                    OrgUnit[]
  employments                 Employment[]
  positions                   Position[]
  managerLinks                ManagerRelation[]
  agentTemplates              AgentTemplate[]
  agentVersions               AgentVersion[]
  agentInstances              AgentInstance[]
  roleAssignments             RoleAssignment[]
  agentRuns                   AgentRun[]
  aiRuntimeRuns               AiRuntimeRun[]
  conversations               Conversation[]
  conversationParticipants    ConversationParticipant[]
  messages                    Message[]
  answerFeedbacks             AnswerFeedback[]
  outboxEvents                OutboxEvent[]
  outboxEventDeliveries       OutboxEventDelivery[]
  auditEvents                 AuditEvent[]
  passwordCredentials         PasswordCredential[]
  authSessions                AuthSession[]
  authActionTokens            AuthActionToken[]
  knowledgeBases              KnowledgeBase[]
  knowledgeDocuments          KnowledgeDocument[]
  knowledgeDocumentVersions   KnowledgeDocumentVersion[]
  knowledgeChunks             KnowledgeChunk[]
  knowledgeChunkEmbeddings    KnowledgeChunkEmbedding[]
  knowledgeIngestionJobs      KnowledgeIngestionJob[]
  knowledgeBaseOrgUnits       KnowledgeBaseOrgUnit[]
  knowledgeEntities           KnowledgeEntity[]
  knowledgeEntityMentions     KnowledgeEntityMention[]
  knowledgeRelations          KnowledgeRelation[]
  knowledgeRelationEvidence   KnowledgeRelationEvidence[]
  directoryIntegrations       DirectoryIntegration[]
  directoryUserBindings       DirectoryUserBinding[]
  directoryOrgUnitBindings    DirectoryOrgUnitBinding[]
  directoryEmploymentBindings DirectoryEmploymentBinding[]
  directorySyncPreviews       DirectorySyncPreview[]
  directorySyncPreviewItems   DirectorySyncPreviewItem[]
  directorySyncRuns           DirectorySyncRun[]

  @@map("tenants")
}

/// Cross-tenant authentication throttle state. Keys are HMAC digests, never
/// raw tenant slugs, email addresses, or network addresses.
model AuthLoginRateLimit {
  keyHash         String    @id @map("key_hash") @db.VarChar(64)
  scope           String    @db.VarChar(32)
  failureCount    Int       @default(0) @map("failure_count")
  windowStartedAt DateTime  @default(now()) @map("window_started_at") @db.Timestamptz(6)
  blockedUntil    DateTime? @map("blocked_until") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@index([updatedAt], map: "auth_login_rate_limits_updated_at_idx")
  @@map("auth_login_rate_limits")
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  tenantId        String     @map("tenant_id") @db.Uuid
  email           String     @db.VarChar(320)
  emailNormalized String     @map("email_normalized") @db.VarChar(320)
  phone           String?    @db.VarChar(40)
  displayName     String     @map("display_name") @db.VarChar(120)
  avatarUrl       String?    @map("avatar_url") @db.Text
  status          UserStatus @default(ACTIVE)
  role            TenantRole @default(MEMBER)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant                            Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  employments                       Employment[]
  ownedAgents                       AgentInstance[]            @relation("AgentOwner")
  createdAgents                     AgentInstance[]            @relation("AgentCreator")
  createdConversations              Conversation[]             @relation("ConversationCreator")
  conversationParticipants          ConversationParticipant[]
  sentMessages                      Message[]                  @relation("UserSentMessages")
  passwordCredential                PasswordCredential?
  authSessions                      AuthSession[]
  authActionTokens                  AuthActionToken[]          @relation("AuthActionTokenUser")
  createdAuthActionTokens           AuthActionToken[]          @relation("AuthActionTokenCreator")
  createdKnowledgeBases             KnowledgeBase[]            @relation("KnowledgeBaseCreator")
  createdKnowledgeDocuments         KnowledgeDocument[]        @relation("KnowledgeDocumentCreator")
  createdKnowledgeDocumentVersions  KnowledgeDocumentVersion[] @relation("KnowledgeDocumentVersionCreator")
  reviewedKnowledgeDocumentVersions KnowledgeDocumentVersion[] @relation("KnowledgeDocumentVersionReviewer")
  requestedAgentRuns                AgentRun[]                 @relation("AgentRunRequester")
  directoryBindings                 DirectoryUserBinding[]
  answerFeedbacks                   AnswerFeedback[]
  roleAssignments                   RoleAssignment[]           @relation("RoleAssignmentUser")
  createdRoleAssignments            RoleAssignment[]           @relation("RoleAssignmentCreator")
  revokedRoleAssignments            RoleAssignment[]           @relation("RoleAssignmentRevoker")
  createdAgentVersions              AgentVersion[]             @relation("AgentVersionCreator")
  reviewRequestedAgentVersions      AgentVersion[]             @relation("AgentVersionReviewRequester")
  reviewedAgentVersions             AgentVersion[]             @relation("AgentVersionReviewer")
  approvedAgentVersions             AgentVersion[]             @relation("AgentVersionApprover")
  publishedAgentVersions            AgentVersion[]             @relation("AgentVersionPublisher")
  retiredAgentVersions              AgentVersion[]             @relation("AgentVersionRetirer")
  requestedDirectorySyncPreviews    DirectorySyncPreview[]     @relation("DirectorySyncPreviewRequester")
  requestedDirectorySyncRuns        DirectorySyncRun[]         @relation("DirectorySyncRunRequester")

  // Composite candidate key for tenant-scoped foreign keys. The globally
  // unique id remains the primary key, while relations must also prove that
  // their parent belongs to the same tenant.
  @@unique([tenantId, id])
  @@unique([tenantId, email])
  @@unique([tenantId, emailNormalized])
  @@index([tenantId, status])
  @@map("users")
}

model Organization {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  externalKey String?  @map("external_key") @db.VarChar(200)
  name        String   @db.VarChar(200)
  legalName   String?  @map("legal_name") @db.VarChar(300)
  countryCode String?  @map("country_code") @db.Char(2)
  timezone    String   @default("Asia/Shanghai") @db.VarChar(80)
  version     Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  orgUnits              OrgUnit[]
  employments           Employment[]
  positions             Position[]
  directoryIntegrations DirectoryIntegration[]

  @@unique([tenantId, id])
  @@unique([tenantId, externalKey])
  @@index([tenantId, name])
  @@map("organizations")
}

model OrgUnit {
  id             String        @id @default(uuid()) @db.Uuid
  tenantId       String        @map("tenant_id") @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  parentId       String?       @map("parent_id") @db.Uuid
  externalKey    String?       @map("external_key") @db.VarChar(200)
  name           String        @db.VarChar(200)
  sortOrder      Int           @default(0) @map("sort_order")
  status         OrgUnitStatus @default(ACTIVE)
  version        Int           @default(1)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant              Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  organization        Organization              @relation(fields: [tenantId, organizationId], references: [tenantId, id], onDelete: Restrict)
  parent              OrgUnit?                  @relation("OrgUnitTree", fields: [tenantId, organizationId, parentId], references: [tenantId, organizationId, id], onDelete: Restrict)
  children            OrgUnit[]                 @relation("OrgUnitTree")
  employments         Employment[]
  positions           Position[]
  knowledgeBaseScopes KnowledgeBaseOrgUnit[]
  directoryBindings   DirectoryOrgUnitBinding[]

  @@unique([tenantId, id])
  @@unique([tenantId, organizationId, id])
  @@unique([tenantId, organizationId, externalKey])
  @@index([tenantId, parentId, sortOrder])
  @@map("org_units")
}

model PasswordCredential {
  userId             String   @id @map("user_id") @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  passwordHash       String   @map("password_hash") @db.Text
  mustChangePassword Boolean  @default(false) @map("must_change_password")
  passwordChangedAt  DateTime @default(now()) @map("password_changed_at") @db.Timestamptz(6)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@map("password_credentials")
}

model AuthSession {
  id                      String     @id @default(uuid()) @db.Uuid
  tenantId                String     @map("tenant_id") @db.Uuid
  userId                  String     @map("user_id") @db.Uuid
  accessTokenHash         String     @unique @map("access_token_hash") @db.Char(64)
  refreshTokenHash        String     @unique @map("refresh_token_hash") @db.Char(64)
  label                   String?    @db.VarChar(120)
  accessExpiresAt         DateTime   @map("access_expires_at") @db.Timestamptz(6)
  refreshExpiresAt        DateTime   @map("refresh_expires_at") @db.Timestamptz(6)
  lastUsedAt              DateTime   @default(now()) @map("last_used_at") @db.Timestamptz(6)
  revokedAt               DateTime?  @map("revoked_at") @db.Timestamptz(6)
  deviceId                String?    @map("device_id") @db.Uuid
  refreshFamilyId         String     @default(dbgenerated("gen_random_uuid()")) @map("refresh_family_id") @db.Uuid
  refreshGeneration       Int        @default(1) @map("refresh_generation")
  lastMfaAt               DateTime?  @map("last_mfa_at") @db.Timestamptz(6)
  lastMfaMethod           MfaMethod? @map("last_mfa_method")
  lastMfaFactorId         String?    @map("last_mfa_factor_id") @db.Uuid
  lastNetworkHash         String?    @map("last_network_hash") @db.Char(64)
  refreshReplayDetectedAt DateTime?  @map("refresh_replay_detected_at") @db.Timestamptz(6)
  revokedReason           String?    @map("revoked_reason") @db.VarChar(500)
  version                 Int        @default(1)
  createdAt               DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, id, userId])
  @@index([tenantId, userId, revokedAt])
  @@index([tenantId, userId, deviceId, revokedAt], map: "auth_sessions_device_active_idx")
  @@index([tenantId, refreshFamilyId, refreshGeneration], map: "auth_sessions_refresh_family_idx")
  @@index([accessExpiresAt])
  @@index([refreshExpiresAt])
  @@map("auth_sessions")
}

/// One-time password-reset and member-invitation capability. The raw token is
/// never persisted in this row; tokenHash is an HMAC using the auth pepper.
/// Reset delivery keeps a separately leased, authenticated-encryption envelope.
model AuthActionToken {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  purpose          String    @db.VarChar(32)
  tokenHash        String    @unique @map("token_hash") @db.Char(64)
  deliveryStatus   String    @default("PENDING") @map("delivery_status") @db.VarChar(24)
  deliveryAttempts Int       @default(0) @map("delivery_attempts")
  lastDeliveryAt   DateTime? @map("last_delivery_at") @db.Timestamptz(6)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt       DateTime? @map("consumed_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdById      String?   @map("created_by_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user      User   @relation("AuthActionTokenUser", fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)
  createdBy User?  @relation("AuthActionTokenCreator", fields: [tenantId, createdById], references: [tenantId, id], onDelete: Restrict)

