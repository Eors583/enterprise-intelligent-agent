NODE_ENV=development
PORT=3000
HOST=127.0.0.1
CORS_ORIGINS=http://localhost:5173
# memory 仅用于本地开发；production 禁用。真实账本联调使用 prisma。
REPOSITORY_DRIVER=memory
DEV_TENANT_ID=00000000-0000-7000-8000-000000000001
DEV_USER_ID=00000000-0000-7000-8000-000000000101
# Production requires a dedicated connector-credential keyring. Each JSON value
# is an unpadded base64url-encoded 32-byte AES key; the active ID selects the
# write key while retained IDs allow non-disruptive rotation and old-key reads.
CONNECTOR_CREDENTIAL_KEYRING_JSON=
CONNECTOR_CREDENTIAL_ACTIVE_KEY_ID=
# 本地 Docker 管理登录。生产 API 登录只能 SET ROLE enterprise_agent_app；
# migration 和 provisioning 任务必须在各自进程注入不同的 DATABASE_URL Secret。
DATABASE_URL=postgresql://enterprise_agent:local-development-only@127.0.0.1:5432/enterprise_agent?schema=public

# 仅当 API 位于已认证、会清洗身份请求头且无法被绕过的可信网关后方时启用。
# 这是 OIDC/SAML 接入前的过渡边界，不代表正式认证已经完成。
TRUST_PROXY_IDENTITY_HEADERS=false

# OTLP/HTTP traces + metrics。生产未启用或启动失败时 /health/ready 会 fail closed。
OTEL_REQUIRED=false
OTEL_SDK_DISABLED=false
OTEL_SERVICE_NAME=enterprise-agent-api
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_EXPORT_STALE_AFTER_MS=120000
OTEL_METRIC_EXPORT_INTERVAL=30000
OTEL_TRACES_SAMPLER_ARG=1
OTEL_DIAGNOSTICS_ENABLED=false

# Controlled web knowledge import. Production must use an exact hostname allowlist.
KNOWLEDGE_WEB_IMPORT_ALLOWED_HOSTS=
KNOWLEDGE_WEB_IMPORT_TIMEOUT_MS=15000
KNOWLEDGE_WEB_IMPORT_MAX_BYTES=5242880

# Production S3 knowledge storage must use the full, region-matched ARN of a
# customer-managed KMS key. Development may leave this empty (for local/MinIO).
KNOWLEDGE_OBJECT_STORE_S3_KMS_KEY_ID=

# Production knowledge writes are explicit opt-in. When enabled in production,
# the embedded durable consumer is mandatory; startup fails if it is disabled,
# readiness remains unhealthy until its first successful queue poll, and write
# endpoints return 503 whenever that consumer later becomes unavailable.
KNOWLEDGE_PERSISTENT_WRITES_ENABLED=false
KNOWLEDGE_INGESTION_WORKER_ENABLED=false
KNOWLEDGE_INGESTION_POLL_INTERVAL_MS=500
KNOWLEDGE_INGESTION_BATCH_SIZE=2
KNOWLEDGE_INGESTION_MAX_ATTEMPTS=5
KNOWLEDGE_INGESTION_RETRY_BASE_MS=1000
KNOWLEDGE_INGESTION_RETRY_MAX_MS=60000
KNOWLEDGE_INGESTION_CLAIM_TTL_MS=120000

# Automatic trusted FinOps projection (development + prisma defaults to true).
FINOPS_PROJECTION_WORKER_ENABLED=true
FINOPS_PROJECTION_BATCH_SIZE=25
FINOPS_PROJECTION_POLL_INTERVAL_MS=5000
FINOPS_PROJECTION_CLAIM_TTL_MS=60000

# Trusted AI Runtime evaluation runner. This secret must match
# AI_RUNTIME_EVALUATION_ATTESTATION_SECRET and remain server-side only.
AI_RUNTIME_URL=http://127.0.0.1:8100
AI_RUNTIME_HTTP_TIMEOUT_MS=90000
AI_EVALUATION_RUNNER_HMAC_SECRET=
