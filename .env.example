NODE_ENV=development
API_PORT=3000
API_HOST=127.0.0.1
API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
# memory 仅供本地开发；production 会拒绝启动。持久化联调改为 prisma。
REPOSITORY_DRIVER=memory
DEFAULT_TENANT_ID=00000000-0000-7000-8000-000000000001
VITE_API_BASE_URL=http://127.0.0.1:3000

POSTGRES_DB=enterprise_agent
POSTGRES_USER=enterprise_agent
POSTGRES_PASSWORD=local-development-only
# 仅供本地 Docker：同一登录承担 migration/API/seed，代码会在事务内 SET LOCAL ROLE。
# 生产必须按进程注入不同 DATABASE_URL：API 登录只能 SET ROLE enterprise_agent_app；
# provisioning 登录只能 SET ROLE enterprise_agent_provisioner；不得复用示例密码或超级用户。
DATABASE_URL=postgresql://enterprise_agent:local-development-only@127.0.0.1:5432/enterprise_agent?schema=public
# 开发可省略并回退 DATABASE_URL；生产启用 Worker 时必须使用不同用户名的专用连接。
OUTBOX_DATABASE_URL=
AUTH_DATABASE_URL=
ADMIN_DATABASE_URL=
AUTH_TOKEN_PEPPER=replace-with-at-least-32-random-characters
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_SECONDS=2592000
# 生产环境强制启用。开发库执行 20260721000500 migration 后再开启。
AUTH_LOGIN_RATE_LIMIT_ENABLED=false
# 生产环境强制启用网络桶；缺失客户端地址会进入固定的 fail-closed 匿名桶。
# 部署反向代理时仍需正确配置可信代理地址解析，避免把代理出口误当作客户端。
AUTH_LOGIN_RATE_LIMIT_NETWORK_ENABLED=false
AUTH_LOGIN_RATE_LIMIT_ACCOUNT_FAILURES=5
AUTH_LOGIN_RATE_LIMIT_NETWORK_FAILURES=30
AUTH_LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_LOGIN_RATE_LIMIT_BLOCK_SECONDS=900
# Hard upper bound for each opaque pre-auth throttle scope. Capacity exhaustion
# fails closed without persisting attacker-controlled account/token buckets.
AUTH_RATE_LIMIT_BUCKET_CAPACITY_PER_SCOPE=100000
# 自助恢复与邀请。公开恢复请求复用上面的生产强制账户/网络限速开关。
AUTH_RECOVERY_RATE_LIMIT_ACCOUNT_REQUESTS=3
AUTH_RECOVERY_RATE_LIMIT_NETWORK_REQUESTS=20
AUTH_RECOVERY_RATE_LIMIT_WINDOW_SECONDS=3600
AUTH_PASSWORD_RESET_TTL_SECONDS=1800
AUTH_MEMBER_INVITATION_TTL_SECONDS=604800
# disabled 时管理员仍可复制一次性邀请链接，但忘记密码邮件不会投递。
# resend 密钥只能通过服务端 Secret/ConfigMap 注入，禁止使用 VITE_* 或写入桌面端。
AUTH_RECOVERY_EMAIL_PROVIDER=disabled
AUTH_RECOVERY_EMAIL_API_KEY=
AUTH_RECOVERY_EMAIL_FROM=
AUTH_RECOVERY_EMAIL_HTTP_TIMEOUT_MS=10000
AUTH_PUBLIC_APP_URL=http://127.0.0.1:4173
# Production defaults to disabled. Enable only after adding your registration controls.
REGISTRATION_MODE=open
# Test-only compatibility bridge for x-user-id/x-tenant-id. Keep false for real desktop login.
ALLOW_DEV_IDENTITY_HEADERS=false
REDIS_URL=redis://127.0.0.1:6379/0

# 可靠 IM Outbox。development + prisma 默认启用；其他环境建议显式配置。
# IM_OUTBOX_ENABLED=true
IM_PROVIDER=local
IM_OUTBOX_POLL_INTERVAL_MS=500
IM_OUTBOX_BATCH_SIZE=20
IM_OUTBOX_MAX_ATTEMPTS=8
IM_OUTBOX_RETRY_BASE_MS=1000
IM_OUTBOX_RETRY_MAX_MS=60000
IM_OUTBOX_CLAIM_TTL_MS=30000
IM_PROVIDER_TIMEOUT_MS=10000

# IM_PROVIDER=tencent 时全部通过后端 Secret/ConfigMap 注入，绝不能写入 Electron。
# API Base URL 只接受代码允许列表中的腾讯官方 HTTPS 域名。
TENCENT_IM_SDK_APP_ID=
TENCENT_IM_ADMIN_USER_ID=
TENCENT_IM_SECRET_KEY=
TENCENT_IM_API_BASE_URL=https://console.tim.qq.com
TENCENT_IM_USER_SIG_TTL_SECONDS=5184000
TENCENT_IM_HTTP_TIMEOUT_MS=5000

# 飞书通讯录单向同步。默认关闭；启用时必须使用 Prisma，并明确绑定一个本地租户 slug。
# App ID/App Secret 仅由 Nest API 服务端通过 Secret/ConfigMap 注入，禁止写入 VITE_*、
# Electron、管理后台构建产物、日志或审计 metadata。API 地址只接受飞书官方 HTTPS Origin。
FEISHU_DIRECTORY_SYNC_ENABLED=false
# Enable only after verifying the app's Feishu contact data range is "all members".
FEISHU_DIRECTORY_RECONCILE_REMOVALS=false
# Imported employees receive this temporary password and must change it after login.
FEISHU_DIRECTORY_INITIAL_PASSWORD=1234567890
FEISHU_DIRECTORY_TARGET_TENANT_SLUG=
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_API_BASE_URL=https://open.feishu.cn
FEISHU_HTTP_TIMEOUT_MS=10000
# 同步租约必须长于单次飞书 HTTP timeout；正式环境需结合组织规模和 Worker 心跳配置。
FEISHU_SYNC_LEASE_MS=1800000

# Nest API 的持久化 Agent Run 编排 Worker。development + prisma 默认启用；
# memory/test 默认关闭。CLAIM_TTL 必须比 HTTP timeout 多 15000ms 以上。
# API 会在自身进程边界主动剥离 MANUS_* 和所有 AI_RUNTIME_*_API_KEY；
# 供应商密钥只允许独立 AI Runtime 进程读取。
# AGENT_RUN_WORKER_ENABLED=true
AGENT_RUN_WORKER_CONCURRENCY=1
AGENT_RUN_POLL_INTERVAL_MS=500
AGENT_RUN_CLAIM_TTL_MS=120000
AI_RUNTIME_URL=http://127.0.0.1:8100
AI_RUNTIME_HTTP_TIMEOUT_MS=90000
# API semantic RAG switch. Keep disabled until pgvector migration is deployed and
# the corresponding AI Runtime providers below pass readiness.
KNOWLEDGE_SEMANTIC_SEARCH_ENABLED=false
KNOWLEDGE_RERANK_ENABLED=false
KNOWLEDGE_AI_TIMEOUT_MS=30000
KNOWLEDGE_EMBEDDING_DIMENSIONS=1536
# exact is the correctness baseline for the small multi-tenant pilot. hnsw must
# pass tenant-filtered Recall@K comparison before production enablement.
KNOWLEDGE_VECTOR_SEARCH_MODE=exact

# Knowledge source files. Local disk is for development only and is rejected in
# production. S3 supports AWS IAM/workload identity (default_chain) and static
# credentials for MinIO. Never expose credentials through VITE_* variables.
KNOWLEDGE_OBJECT_STORE_DRIVER=local
KNOWLEDGE_OBJECT_STORE_MAX_BYTES=52428800
# Optional absolute directory. Empty uses <workspace>/.data/knowledge-objects.
KNOWLEDGE_OBJECT_STORE_LOCAL_ROOT=
# Leave endpoint empty for AWS S3; set an origin such as http://127.0.0.1:9000
# for a development MinIO instance. Production endpoints, when set, require HTTPS.
KNOWLEDGE_OBJECT_STORE_S3_ENDPOINT=
KNOWLEDGE_OBJECT_STORE_S3_REGION=us-east-1
KNOWLEDGE_OBJECT_STORE_S3_BUCKET=
KNOWLEDGE_OBJECT_STORE_S3_CREDENTIAL_MODE=default_chain
KNOWLEDGE_OBJECT_STORE_S3_ACCESS_KEY_ID=
KNOWLEDGE_OBJECT_STORE_S3_SECRET_ACCESS_KEY=
KNOWLEDGE_OBJECT_STORE_S3_FORCE_PATH_STYLE=true
KNOWLEDGE_OBJECT_STORE_S3_PREFIX=knowledge/v1
# disabled returns NOT_SCANNED, never CLEAN. Production rejects disabled.
# clamav streams bounded bytes to a private clamd service and fails closed.
KNOWLEDGE_FILE_SCANNER_DRIVER=disabled
KNOWLEDGE_FILE_SCANNER_CLAMAV_HOST=127.0.0.1
KNOWLEDGE_FILE_SCANNER_CLAMAV_PORT=3310
KNOWLEDGE_FILE_SCANNER_TIMEOUT_MS=30000
# Development may use local; production requires Docling over HTTPS with an API key.
KNOWLEDGE_DOCUMENT_PARSER_DRIVER=local
KNOWLEDGE_DOCLING_BASE_URL=http://127.0.0.1:5001
KNOWLEDGE_DOCLING_API_KEY=
KNOWLEDGE_DOCLING_TIMEOUT_MS=120000
KNOWLEDGE_DOCLING_MAX_RESPONSE_BYTES=33554432

# Durable document ingestion worker. HTTP uploads only enqueue; at least one
# worker must be enabled in every environment that accepts knowledge writes.
KNOWLEDGE_INGESTION_WORKER_ENABLED=true
KNOWLEDGE_INGESTION_POLL_INTERVAL_MS=500
KNOWLEDGE_INGESTION_BATCH_SIZE=2
KNOWLEDGE_INGESTION_MAX_ATTEMPTS=5
KNOWLEDGE_INGESTION_RETRY_BASE_MS=1000
KNOWLEDGE_INGESTION_RETRY_MAX_MS=60000
KNOWLEDGE_INGESTION_CLAIM_TTL_MS=120000

# AI Runtime 在 development/test 启动时会非覆盖式加载仓库根 .env；production 不加载。
# .env.example 仅列出变量名，真实密钥仍须通过进程 Secret/ConfigMap 注入。
# pnpm dev:ai 当前监听 127.0.0.1:8100。
AI_RUNTIME_ENVIRONMENT=development
AI_RUNTIME_DRIVER=noop
AI_RUNTIME_STORE_DRIVER=memory
# 仅在 AI_RUNTIME_DRIVER=openai_compatible 时配置，并通过 Secret 注入真实密钥。
AI_RUNTIME_OPENAI_BASE_URL=
AI_RUNTIME_OPENAI_API_KEY=
AI_RUNTIME_OPENAI_MODEL=
# 知识 Embedding 与对话 Run 驱动相互独立；默认关闭，不会发出供应商请求。
# 启用后调用 {BASE_URL}/embeddings，当前 pgvector 数据契约固定为 1536 维。
AI_RUNTIME_EMBEDDING_DRIVER=disabled
AI_RUNTIME_EMBEDDING_BASE_URL=
AI_RUNTIME_EMBEDDING_API_KEY=
AI_RUNTIME_EMBEDDING_MODEL=
AI_RUNTIME_EMBEDDING_DIMENSIONS=1536
AI_RUNTIME_EMBEDDING_TIMEOUT_SECONDS=30
# Rerank 使用 Cohere-compatible {BASE_URL}/rerank；默认关闭。
AI_RUNTIME_RERANK_DRIVER=disabled
AI_RUNTIME_RERANK_BASE_URL=
AI_RUNTIME_RERANK_API_KEY=
AI_RUNTIME_RERANK_MODEL=
AI_RUNTIME_RERANK_TIMEOUT_SECONDS=30
# 仅在 AI_RUNTIME_DRIVER=manus 时配置。不得复用账号级 agent-default-main_task。
MANUS_API_KEY=
MANUS_API_BASE_URL=https://api.manus.ai
# Optional explicit HTTP(S) proxy for environments where the runtime cannot inherit the OS proxy.
MANUS_PROXY_URL=
MANUS_AGENT_PROFILE=manus-1.6-lite
MANUS_PROJECT_ID=
MANUS_POLL_INTERVAL_SECONDS=2
MANUS_MAX_WAIT_SECONDS=120
