NODE_ENV=development
API_PORT=3000
API_HOST=127.0.0.1
API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
# memory 仅供本地开发；production 会拒绝启动。持久化联调改为 prisma。
REPOSITORY_DRIVER=memory
DEFAULT_TENANT_ID=00000000-0000-7000-8000-000000000001
VITE_API_BASE_URL=http://127.0.0.1:3000
# Optional isolated-UAT overrides. Defaults keep the normal 4173/3000 pair;
# set VITE_API_BASE_URL=/api/v1 to exercise the same-origin proxy.
VITE_ADMIN_PORT=4173
VITE_API_PROXY_TARGET=http://127.0.0.1:3000

POSTGRES_DB=enterprise_agent
POSTGRES_USER=enterprise_agent
POSTGRES_PASSWORD=local-development-only
# 仅供本地 Docker：同一登录承担 migration/API/seed，代码会在事务内 SET LOCAL ROLE。
# 生产必须按进程注入不同 DATABASE_URL：API 登录只能 SET ROLE enterprise_agent_app；
# provisioning 登录只能 SET ROLE enterprise_agent_provisioner；不得复用示例密码或超级用户。
DATABASE_URL=postgresql://enterprise_agent:local-development-only@127.0.0.1:5432/enterprise_agent?schema=public
# 开发可省略并回退 DATABASE_URL；生产必须为 API/Auth/Admin/Lifecycle/Worker
# 使用彼此不同用户名的专用连接，任一登录不得同时持有两个 capability role。
OUTBOX_DATABASE_URL=
AUTH_DATABASE_URL=
ADMIN_DATABASE_URL=
LIFECYCLE_DATABASE_URL=
AUTH_TOKEN_PEPPER=replace-with-at-least-32-random-characters
# Dedicated AES-256-GCM keyring for connector credentials. Values are unpadded
# base64url-encoded 32-byte keys. Keep retired keys until all stored envelopes
# have been rotated. Production requires both settings and must not reuse the
# authentication pepper. Example generation: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
CONNECTOR_CREDENTIAL_KEYRING_JSON=
CONNECTOR_CREDENTIAL_ACTIVE_KEY_ID=
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_SECONDS=2592000
# 生产环境强制启用。开发库执行 20260721000500 migration 后再开启。
AUTH_LOGIN_RATE_LIMIT_ENABLED=false
# 生产环境强制启用网络桶；缺失客户端地址会进入固定的 fail-closed 匿名桶。
# 部署反向代理时仍需正确配置可信代理地址解析，避免把代理出口误当作客户端。
AUTH_LOGIN_RATE_LIMIT_NETWORK_ENABLED=false
AUTH_LOGIN_RATE_LIMIT_ACCOUNT_FAILURES=5
AUTH_LOGIN_RATE_LIMIT_NETWORK_FAILURES=30
AUTH_LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_LOGIN_RATE_LIMIT_BLOCK_SECONDS=900
# Hard upper bound for each opaque pre-auth throttle scope. Capacity exhaustion
# fails closed without persisting attacker-controlled account/token buckets.
AUTH_RATE_LIMIT_BUCKET_CAPACITY_PER_SCOPE=100000
# 自助恢复与邀请。公开恢复请求复用上面的生产强制账户/网络限速开关。
AUTH_RECOVERY_RATE_LIMIT_ACCOUNT_REQUESTS=3
AUTH_RECOVERY_RATE_LIMIT_NETWORK_REQUESTS=20
AUTH_RECOVERY_RATE_LIMIT_WINDOW_SECONDS=3600
AUTH_PASSWORD_RESET_TTL_SECONDS=1800
AUTH_MEMBER_INVITATION_TTL_SECONDS=604800
# Manual fallback is returned only when email delivery is unavailable.
AUTH_MEMBER_INVITATION_FALLBACK_TTL_SECONDS=900
# disabled 时管理员仍可复制一次性邀请链接，但忘记密码邮件不会投递。
# resend 密钥只能通过服务端 Secret/ConfigMap 注入，禁止使用 VITE_* 或写入桌面端。
AUTH_RECOVERY_EMAIL_PROVIDER=disabled
AUTH_RECOVERY_EMAIL_API_KEY=
AUTH_RECOVERY_EMAIL_FROM=
AUTH_RECOVERY_EMAIL_HTTP_TIMEOUT_MS=10000
AUTH_PUBLIC_APP_URL=http://127.0.0.1:4173
# Production defaults to disabled. Enable only after adding your registration controls.
REGISTRATION_MODE=open
# Test-only compatibility bridge for x-user-id/x-tenant-id. Keep false for real desktop login.
ALLOW_DEV_IDENTITY_HEADERS=false
REDIS_URL=redis://127.0.0.1:6379/0

# OpenTelemetry OTLP/HTTP。开发环境未配置 Collector 时保持关闭；生产环境默认将其
# 视为 readiness 必需能力。Header 仅从服务端 Secret 注入，禁止写入 VITE_*。
OTEL_REQUIRED=false
OTEL_SDK_DISABLED=false
OTEL_SERVICE_NAME=enterprise-agent-api
OTEL_EXPORTER_OTLP_ENDPOINT=
# 也可不用公共 endpoint，而同时提供以下两个精确信号 endpoint。
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_EXPORT_STALE_AFTER_MS=120000
OTEL_METRIC_EXPORT_INTERVAL=30000
OTEL_TRACES_SAMPLER_ARG=1
OTEL_DIAGNOSTICS_ENABLED=false

# 可靠 IM Outbox。development + prisma 默认启用；其他环境建议显式配置。
# IM_OUTBOX_ENABLED=true
IM_PROVIDER=local
IM_OUTBOX_POLL_INTERVAL_MS=500
IM_OUTBOX_BATCH_SIZE=20
IM_OUTBOX_MAX_ATTEMPTS=8
IM_OUTBOX_RETRY_BASE_MS=1000
IM_OUTBOX_RETRY_MAX_MS=60000
IM_OUTBOX_CLAIM_TTL_MS=30000
IM_PROVIDER_TIMEOUT_MS=10000

# IM_PROVIDER=tencent 时全部通过后端 Secret/ConfigMap 注入，绝不能写入 Electron。
# API Base URL 只接受代码允许列表中的腾讯官方 HTTPS 域名。
TENCENT_IM_SDK_APP_ID=
TENCENT_IM_ADMIN_USER_ID=
TENCENT_IM_SECRET_KEY=
TENCENT_IM_API_BASE_URL=https://console.tim.qq.com
TENCENT_IM_USER_SIG_TTL_SECONDS=5184000
TENCENT_IM_HTTP_TIMEOUT_MS=5000

# Self-hosted WuKongIM transport. Select with IM_PROVIDER=wukong.
# The REST endpoint is server-only; expose it only on loopback or an internal
# service network. Desktop clients receive only the public WS/WSS endpoint and
# a tenant-scoped user token after authenticating with this API.
# The audited upstream revision does not enforce this REST token itself. In a
# production deployment the endpoint must sit behind an authenticated internal
# proxy and the gateway must use a revision with working token-verifier hooks.
WUKONG_IM_API_BASE_URL=http://127.0.0.1:5501
WUKONG_IM_PUBLIC_WS_URL=ws://127.0.0.1:5520
WUKONG_IM_API_TOKEN=
WUKONG_IM_TOKEN_SIGNING_SECRET=
WUKONG_IM_HTTP_TIMEOUT_MS=5000
# Keep false until an independent probe proves REST proxy authentication and
# gateway token verification reject missing/invalid credentials.
WUKONG_IM_VERIFIED_AUTH_ENABLED=false

# 飞书通讯录单向同步。默认关闭；启用时必须使用 Prisma，并明确绑定一个本地租户 slug。
# App ID/App Secret 仅由 Nest API 服务端通过 Secret/ConfigMap 注入，禁止写入 VITE_*、
# Electron、管理后台构建产物、日志或审计 metadata。API 地址只接受飞书官方 HTTPS Origin。
FEISHU_DIRECTORY_SYNC_ENABLED=false
# Enable only after verifying the app's Feishu contact data range is "all members".
FEISHU_DIRECTORY_RECONCILE_REMOVALS=false
# Imported members do not receive a shared password. Activate password login
# only with a one-time member invitation, or use the tenant's configured SSO.
FEISHU_DIRECTORY_TARGET_TENANT_SLUG=
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_API_BASE_URL=https://open.feishu.cn
FEISHU_HTTP_TIMEOUT_MS=10000
# 同步租约必须长于单次飞书 HTTP timeout；正式环境需结合组织规模和 Worker 心跳配置。
FEISHU_SYNC_LEASE_MS=1800000
FEISHU_SYNC_PREVIEW_TTL_MS=900000
FEISHU_SYNC_WORKER_ENABLED=true
FEISHU_SYNC_WORKER_POLL_INTERVAL_MS=2000
FEISHU_SYNC_WORKER_BATCH_SIZE=2
FEISHU_SYNC_MAX_ATTEMPTS=4
FEISHU_SYNC_RETRY_BASE_MS=10000
FEISHU_SYNC_RETRY_MAX_MS=300000

# Nest API 的持久化 Agent Run 编排 Worker。development + prisma 默认启用；
# memory/test 默认关闭。CLAIM_TTL 必须比 HTTP timeout 多 15000ms 以上。
# API 会在自身进程边界主动剥离 MANUS_* 和所有 AI_RUNTIME_*_API_KEY；
# 供应商密钥只允许独立 AI Runtime 进程读取。
# AGENT_RUN_WORKER_ENABLED=true
# Parallel Run slots per API worker. Quota, tenant locking, and model-route
# circuit breakers still apply independently to every Run.
AGENT_RUN_WORKER_CONCURRENCY=4
AGENT_RUN_POLL_INTERVAL_MS=500
AGENT_RUN_CLAIM_TTL_MS=360000
# UNKNOWN 只按原 externalRunId 延时探测；到期不会判失败或创建新远端任务。
AGENT_RUN_UNKNOWN_RECONCILIATION_DELAY_MS=300000

# Durable Tool Gateway executor. Endpoint bindings are server-only secrets and
# must never be exposed through VITE_*, Tool Version responses, logs, or audit metadata.
TOOL_EXECUTION_WORKER_ENABLED=true
TOOL_EXECUTION_WORKER_CONCURRENCY=2
TOOL_EXECUTION_POLL_INTERVAL_MS=500
# Tool Versions allow up to 120s; the lease retains more than 15s of recovery margin.
TOOL_EXECUTION_CLAIM_TTL_MS=180000
# Enforced transactionally per tenant + immutable Tool Version across API replicas.
TOOL_MAX_CONCURRENT_PER_VERSION=4
TOOL_MAX_STARTS_PER_MINUTE_PER_VERSION=60
TOOL_PROVIDER_MAX_RESPONSE_BYTES=1048576
TOOL_CIRCUIT_FAILURE_THRESHOLD=5
TOOL_CIRCUIT_OPEN_MS=30000
# Configure the platform-controlled recursive resolvers explicitly in production.
TOOL_DNS_SERVERS=1.1.1.1,8.8.8.8
# JSON object keyed by an opaque secret://, vault://, or kms:// endpointRef.
# Inject the real value through Secret/ConfigMap. Example shape only:
# {"secret://tenant/crm/customer":{"url":"https://crm.example.com/api/customer","method":"POST","headers":{"authorization":"Bearer <scoped-token>"},"signingSecret":"<at-least-32-characters>"}}
TOOL_ENDPOINT_BINDINGS_JSON=

# Reliable Agent Run / Tool settlement to FinOps ledger reconciler. It admits
# only terminal non-UNKNOWN sources with trusted usage/cost evidence and exact
# approved prices. Missing prices or mismatches remain BLOCKED diagnostics.
FINOPS_PROJECTION_WORKER_ENABLED=true
FINOPS_PROJECTION_BATCH_SIZE=25
FINOPS_PROJECTION_POLL_INTERVAL_MS=5000
FINOPS_PROJECTION_CLAIM_TTL_MS=60000

AI_RUNTIME_URL=http://127.0.0.1:8100
AI_RUNTIME_HTTP_TIMEOUT_MS=330000
# Must equal AI_RUNTIME_EVALUATION_ATTESTATION_SECRET in the trusted Runtime.
# Use a dedicated secret of at least 32 random characters; never expose it to browsers.
AI_EVALUATION_RUNNER_HMAC_SECRET=
# API semantic RAG switch. Keep disabled until pgvector migration is deployed and
# the corresponding AI Runtime providers below pass readiness.
KNOWLEDGE_SEMANTIC_SEARCH_ENABLED=false
KNOWLEDGE_RERANK_ENABLED=false
KNOWLEDGE_AI_TIMEOUT_MS=30000
KNOWLEDGE_EMBEDDING_DIMENSIONS=1536
# exact is the correctness baseline for the small multi-tenant pilot. hnsw must
# pass tenant-filtered Recall@K comparison before production enablement.
KNOWLEDGE_VECTOR_SEARCH_MODE=exact

# Large-corpus deployments use Qdrant for dense+sparse retrieval. PostgreSQL is
# retained as a development fallback and the authoritative business ledger.
KNOWLEDGE_SEARCH_INDEX_DRIVER=postgres
KNOWLEDGE_QDRANT_URL=http://127.0.0.1:6333
KNOWLEDGE_QDRANT_API_KEY=
KNOWLEDGE_QDRANT_COLLECTION=enterprise_knowledge_chunks_v1
KNOWLEDGE_QDRANT_TIMEOUT_MS=10000

# Knowledge source files. Local disk is for development only and is rejected in
# production. S3 supports AWS IAM/workload identity (default_chain) and static
# credentials for MinIO. Never expose credentials through VITE_* variables.
KNOWLEDGE_OBJECT_STORE_DRIVER=local
KNOWLEDGE_OBJECT_STORE_MAX_BYTES=2147483647
# Optional absolute directory. Empty uses <workspace>/.data/knowledge-objects.
KNOWLEDGE_OBJECT_STORE_LOCAL_ROOT=
# Leave endpoint empty for AWS S3; set an origin such as http://127.0.0.1:9000
# for a development MinIO instance. Production endpoints, when set, require HTTPS.
KNOWLEDGE_OBJECT_STORE_S3_ENDPOINT=
KNOWLEDGE_OBJECT_STORE_S3_REGION=us-east-1
KNOWLEDGE_OBJECT_STORE_S3_BUCKET=
KNOWLEDGE_OBJECT_STORE_S3_CREDENTIAL_MODE=default_chain
KNOWLEDGE_OBJECT_STORE_S3_ACCESS_KEY_ID=
KNOWLEDGE_OBJECT_STORE_S3_SECRET_ACCESS_KEY=
KNOWLEDGE_OBJECT_STORE_S3_FORCE_PATH_STYLE=true
KNOWLEDGE_OBJECT_STORE_S3_PREFIX=knowledge/v1
# Production requires the full customer-managed KMS key ARN. The API sends it
# on every PutObject and rejects Head/Get responses that do not report this
# exact key with ServerSideEncryption=aws:kms. Development may leave it empty.
KNOWLEDGE_OBJECT_STORE_S3_KMS_KEY_ID=
# disabled returns NOT_SCANNED, never CLEAN. Production rejects disabled.
# clamav streams bounded bytes to a private clamd service and fails closed.
KNOWLEDGE_FILE_SCANNER_DRIVER=disabled
KNOWLEDGE_FILE_SCANNER_CLAMAV_HOST=127.0.0.1
KNOWLEDGE_FILE_SCANNER_CLAMAV_PORT=3310
KNOWLEDGE_FILE_SCANNER_TIMEOUT_MS=90000
# Development may use local; production requires Docling over HTTPS with an API key.
KNOWLEDGE_DOCUMENT_PARSER_DRIVER=local
KNOWLEDGE_DOCLING_BASE_URL=http://127.0.0.1:5001
KNOWLEDGE_DOCLING_API_KEY=
KNOWLEDGE_DOCLING_TIMEOUT_MS=120000
KNOWLEDGE_DOCLING_MAX_RESPONSE_BYTES=33554432
KNOWLEDGE_TIKA_BASE_URL=http://127.0.0.1:9998
KNOWLEDGE_TIKA_TIMEOUT_MS=120000
KNOWLEDGE_TIKA_MAX_RESPONSE_BYTES=33554432
# Comma-separated exact public HTTPS hosts. Required in production; wildcards are forbidden.
KNOWLEDGE_WEB_IMPORT_ALLOWED_HOSTS=
KNOWLEDGE_WEB_IMPORT_TIMEOUT_MS=15000
KNOWLEDGE_WEB_IMPORT_MAX_BYTES=5242880
# Provider-neutral incremental document source. Production should allow only
# exact connector hosts. The local fixture switch is development/test-only.
KNOWLEDGE_SOURCE_SYNC_ALLOWED_HOSTS=
KNOWLEDGE_SOURCE_SYNC_TIMEOUT_MS=20000
KNOWLEDGE_SOURCE_SYNC_MANIFEST_MAX_BYTES=2097152
KNOWLEDGE_SOURCE_SYNC_MAX_PAGES=100
KNOWLEDGE_SOURCE_SYNC_ALLOW_LOCAL_FIXTURE=false

# Durable document ingestion worker. HTTP uploads only enqueue; at least one
# worker must be enabled in every environment that accepts knowledge writes.
# Production defaults this switch to false. Set it to true only on an API
# deployment that also enables the embedded worker and passes /health/ready.
KNOWLEDGE_LOCAL_BACKEND_ENABLED=false
KNOWLEDGE_PERSISTENT_WRITES_ENABLED=true
KNOWLEDGE_INGESTION_WORKER_ENABLED=true
KNOWLEDGE_INGESTION_POLL_INTERVAL_MS=500
KNOWLEDGE_INGESTION_BATCH_SIZE=2
KNOWLEDGE_INGESTION_MAX_ATTEMPTS=5
KNOWLEDGE_INGESTION_RETRY_BASE_MS=1000
KNOWLEDGE_INGESTION_RETRY_MAX_MS=60000
KNOWLEDGE_INGESTION_CLAIM_TTL_MS=120000

# AI Runtime 在 development/test 启动时会非覆盖式加载仓库根 .env；production 不加载。
# .env.example 仅列出变量名，真实密钥仍须通过进程 Secret/ConfigMap 注入。
# pnpm dev:ai 当前监听 127.0.0.1:8100。
AI_RUNTIME_ENVIRONMENT=development
AI_RUNTIME_DRIVER=noop
AI_RUNTIME_STORE_DRIVER=memory
# API 与 AI Runtime 必须注入同一条至少 32 字符的服务凭据；生产内部接口强制校验。
AI_RUNTIME_SERVICE_TOKEN=
# Must equal AI_EVALUATION_RUNNER_HMAC_SECRET in the API process. When absent,
# evaluation execution and release publication fail closed.
AI_RUNTIME_EVALUATION_ATTESTATION_SECRET=
# AI_RUNTIME_STORE_DRIVER=postgres 时必填，并应使用 AI Runtime 专用数据库身份；
# 生产 DSN 必须显式配置 sslmode=require、verify-ca 或 verify-full。
AI_RUNTIME_POSTGRES_DSN=
AI_RUNTIME_POSTGRES_POOL_MIN_SIZE=1
AI_RUNTIME_POSTGRES_POOL_MAX_SIZE=10
AI_RUNTIME_POSTGRES_COMMAND_TIMEOUT_SECONDS=10
# AI Runtime 在共享 dotenv 中优先使用隔离别名，避免与 Nest API 的 OTEL_SERVICE_NAME
# 串用；生产进程也可直接注入对应的标准 OTEL_* 变量。
AI_RUNTIME_OTEL_REQUIRED=false
AI_RUNTIME_OTEL_SDK_DISABLED=false
AI_RUNTIME_OTEL_SERVICE_NAME=enterprise-ai-runtime
AI_RUNTIME_OTEL_EXPORTER_OTLP_ENDPOINT=
AI_RUNTIME_OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
AI_RUNTIME_OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
AI_RUNTIME_OTEL_EXPORTER_OTLP_HEADERS=
AI_RUNTIME_OTEL_EXPORTER_OTLP_TIMEOUT=5
AI_RUNTIME_OTEL_EXPORT_STALE_AFTER_SECONDS=120
AI_RUNTIME_OTEL_METRIC_EXPORT_INTERVAL=30000
AI_RUNTIME_OTEL_TRACES_SAMPLER_ARG=1
# 仅在 AI_RUNTIME_DRIVER=openai_compatible 时配置，并通过 Secret 注入真实密钥。
AI_RUNTIME_OPENAI_BASE_URL=
AI_RUNTIME_OPENAI_API_KEY=
AI_RUNTIME_OPENAI_MODEL=
# 知识 Embedding 与对话 Run 驱动相互独立；默认关闭，不会发出供应商请求。
# 启用后调用 {BASE_URL}/embeddings。维度支持 1～16000；更换模型或维度时，
# 必须在知识库中创建并重建新的索引版本，不能覆盖现有生效索引。
AI_RUNTIME_EMBEDDING_DRIVER=disabled
AI_RUNTIME_EMBEDDING_BASE_URL=
AI_RUNTIME_EMBEDDING_API_KEY=
AI_RUNTIME_EMBEDDING_MODEL=
AI_RUNTIME_EMBEDDING_DIMENSIONS=1536
AI_RUNTIME_EMBEDDING_TIMEOUT_SECONDS=30
# Rerank 使用 Cohere-compatible {BASE_URL}/rerank；默认关闭。
AI_RUNTIME_RERANK_DRIVER=disabled
AI_RUNTIME_RERANK_BASE_URL=
AI_RUNTIME_RERANK_API_KEY=
AI_RUNTIME_RERANK_MODEL=
AI_RUNTIME_RERANK_TIMEOUT_SECONDS=30
# local_fastembed uses local ONNX models and does not require provider API keys.
# Production must pre-provision the cache and set ALLOW_DOWNLOAD=false.
AI_RUNTIME_LOCAL_MODEL_CACHE_DIR=.data/ai-models
AI_RUNTIME_LOCAL_MODEL_ALLOW_DOWNLOAD=true
AI_RUNTIME_LOCAL_MODEL_THREADS=2
# Production and governed pilot environments should require a server-side route allowlist.
AI_RUNTIME_REQUIRE_TRUSTED_MODEL_ROUTE=false
AI_RUNTIME_MODEL_ROUTE_CATALOG=[]
# 仅在 AI_RUNTIME_DRIVER=manus 时配置。不得复用账号级 agent-default-main_task。
MANUS_API_KEY=
MANUS_API_BASE_URL=https://api.manus.ai
# Optional explicit HTTP(S) proxy for environments where the runtime cannot inherit the OS proxy.
MANUS_PROXY_URL=
MANUS_AGENT_PROFILE=manus-1.6-lite
MANUS_PROJECT_ID=
MANUS_POLL_INTERVAL_SECONDS=2
# 兼容配置：仅限制 Manus 轮询 HTTP；创建和取得 task_id 后均不限制总运行时长。
MANUS_MAX_WAIT_SECONDS=300
